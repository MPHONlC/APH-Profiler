<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="APH-Profiler">
            <Action name="APHPROFILER_TOGGLE_HUD">
                <Down>APHProfilerCore.ToggleHud()</Down>
            </Action>
            <Action name="APHPROFILER_MOVE_HUD">
                <Down>APHProfilerCore.ToggleHudMoveMode()</Down>
            </Action>
            <Action name="APHPROFILER_FOCUS_HUD">
                <Down>APHProfilerCore.ToggleHudFocus()</Down>
            </Action>
            <Action name="APHPROFILER_HUD_MENU">
                <Down>APHProfilerCore.OpenHudMenu()</Down>
            </Action>
        </Category>
    </Layer>
    <Layer name="APHProfiler_HudFocus">
        <Category>
            <Action name="APHPROFILER_HUD_UP" hideAction="true" inheritsBindFrom="UI_SHORTCUT_INPUT_UP">
                <Down>return APHProfilerCore.MoveHudFocus(-1)</Down>
            </Action>
            <Action name="APHPROFILER_HUD_DOWN" hideAction="true" inheritsBindFrom="UI_SHORTCUT_INPUT_DOWN">
                <Down>return APHProfilerCore.MoveHudFocus(1)</Down>
            </Action>
            <Action name="APHPROFILER_HUD_SELECT" hideAction="true" inheritsBindFrom="UI_SHORTCUT_PRIMARY">
                <Down>return APHProfilerCore.ActivateHudFocus()</Down>
            </Action>
            <Action name="APHPROFILER_HUD_SCAN" hideAction="true" inheritsBindFrom="UI_SHORTCUT_SECONDARY">
                <Down>return APHProfilerCore.PadAction("scan")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_MENU_PAD" hideAction="true" inheritsBindFrom="UI_SHORTCUT_TERTIARY">
                <Down>return APHProfilerCore.PadAction("menu")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_SUMMARY" hideAction="true" inheritsBindFrom="UI_SHORTCUT_LEFT_SHOULDER">
                <Down>return APHProfilerCore.PadAction("summary")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_TIMELINE" hideAction="true" inheritsBindFrom="UI_SHORTCUT_RIGHT_SHOULDER">
                <Down>return APHProfilerCore.PadAction("timeline")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_PAGE_UP" hideAction="true" inheritsBindFrom="UI_SHORTCUT_LEFT_TRIGGER">
                <Down>return APHProfilerCore.PadAction("page_up")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_PAGE_DOWN" hideAction="true" inheritsBindFrom="UI_SHORTCUT_RIGHT_TRIGGER">
                <Down>return APHProfilerCore.PadAction("page_down")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_PAN_LEFT" hideAction="true" inheritsBindFrom="UI_SHORTCUT_INPUT_LEFT">
                <Down>return APHProfilerCore.PadAction("pan_left")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_PAN_RIGHT" hideAction="true" inheritsBindFrom="UI_SHORTCUT_INPUT_RIGHT">
                <Down>return APHProfilerCore.PadAction("pan_right")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_MOVE_PAD" hideAction="true" inheritsBindFrom="UI_SHORTCUT_RIGHT_STICK">
                <Down>return APHProfilerCore.PadAction("move")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_RESIZE" hideAction="true" inheritsBindFrom="UI_SHORTCUT_LEFT_STICK">
                <Down>return APHProfilerCore.PadAction("resize")</Down>
            </Action>
            <Action name="APHPROFILER_HUD_BACK" hideAction="true" inheritsBindFrom="UI_SHORTCUT_NEGATIVE">
                <Down>return APHProfilerCore.PadAction("back")</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
